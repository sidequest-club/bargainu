# Copy to collector/.env for local runs. .env is not committed.
# In GitHub Actions these come from repository secrets with the same names.

# https://webservice.rakuten.co.jp/ > Your Applications
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Optional. When set, Rakuten fills affiliateUrl in the response.
RAKUTEN_AFFILIATE_ID=

# Must match a domain in the app's "Allowed websites" list.
RAKUTEN_REFERER=https://github.com/
