{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bargainu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth needs AsyncLocalStorage on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Page routes are served as static files and never reach the Worker; only /api/* does.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bargainu",
      // Replace with the id from `npx wrangler d1 create bargainu` in the team account.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  // Set locally in .dev.vars and in production with `wrangler secret put`.
  "secrets": {
    "required": [
      "BETTER_AUTH_URL",
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
    ],
  },
  "observability": { "enabled": true },
}
