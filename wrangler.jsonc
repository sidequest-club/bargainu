{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bargainu",
  // The team's Cloudflare account (Sidequest Club), so no command lands on a personal one.
  "account_id": "23aad27a2abddb9d42b66c967c78c815",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth needs AsyncLocalStorage on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Page routes are served as static files and never reach the Worker; only /api/* does.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bargainu",
      "database_id": "daf9bd58-ebeb-4b37-822e-fb04d05af1f1",
      "migrations_dir": "drizzle",
    },
  ],
  // Set locally in .dev.vars and in production with `wrangler secret put`.
  "secrets": {
    "required": [
      "BETTER_AUTH_URL",
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
    ],
  },
  "observability": { "enabled": true },
}
