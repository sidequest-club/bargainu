" source="deploy" target="worker"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="1. apply migrations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.782;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deploy" target="d1"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1455" y="470"/><mxPoint x="1455" y="635"/><mxPoint x="900" y="635"/></Array></mxGeometry></mxCell><mxCell id="e10" value="Item Search&lt;br&gt;requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=0.796;exitY=1;exitDx=0;exitDy=0;entryX=0.742;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;strokeColor=#8A8A8A;fontColor=#555555;" edge="1" parent="1" source="rakutenpy" target="rakuten"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="raw NDJSON files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.856;exitDx=0;exitDy=0;entryX=1;entryY=0.089;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;strokeColor=#8A8A8A;fontColor=#555555;" edge="1" parent="1" source="upload" target="r2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="MISSING:&lt;br&gt;load into deals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPatt