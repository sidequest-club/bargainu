<mxfile host="Electron"><diagram id="as-is" name="As-is"><mxGraphModel adaptiveColors="auto" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;Bargainu: as-is architecture&lt;/b&gt;&lt;br&gt;How the app is connected on 2026-10-11, read from the repository, the GitHub settings and the team Cloudflare account." style="text;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="70" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;Live today&lt;/b&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1530" y="30" width="145" height="44" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;Behind login&lt;/b&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E3F3E6;strokeColor=#2E7D32;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1685" y="30" width="145" height="44" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;b&gt;In the repo, not set up or never run&lt;/b&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#8A8A8A;fontColor=#555555;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1840" y="30" width="145" height="44" as="geometry"/></mxCell><mxCell id="lg4" value="&lt;b&gt;Missing&lt;/b&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FDECEA;strokeColor=#C62828;fontColor=#8E1B1B;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1995" y="30" width="145" height="44" as="geometry"/></mxCell><mxCell id="browser" value="Visitor's browser" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#EAF1FB;strokeColor=#3B6FB6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="510" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;Frontend: React app&lt;/b&gt; (Vite, React Router, src/)&lt;br&gt;Downloaded as static files, then runs in the browser. Calls the API on the same origin with a typed client (hono/client) and the Better Auth client." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#3B6FB6;" vertex="1" parent="browser"><mxGeometry x="15" y="42" width="370" height="92" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;Open to everyone&lt;/b&gt;&lt;br&gt;/ : Home, with Top Discounts&lt;br&gt;/browse : every deal, with filters&lt;br&gt;/deal/:id : one deal and the link to the store&lt;br&gt;/login : Continue with Google&lt;br&gt;&lt;br&gt;Loads every live deal once per page load (GET /api/deals). Filtering and sorting happen in the browser." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#3B6FB6;" vertex="1" parent="browser"><mxGeometry x="15" y="146" width="370" height="170" as="geometry"/></mxCell><mxCell id="behind" value="&lt;b&gt;Behind login&lt;/b&gt;&lt;br&gt;/favorites : the list of saved deals&lt;br&gt;Heart button on a deal: save or remove it&lt;br&gt;&lt;br&gt;Signed out, the heart sends the visitor to /login and saves the deal once they are back. The session is a Better Auth cookie set by the Worker; the app asks for it on every page load." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E3F3E6;strokeColor=#2E7D32;" vertex="1" parent="browser"><mxGeometry x="15" y="328" width="370" height="166" as="geometry"/></mxCell><mxCell id="google" value="&lt;b&gt;Google sign-in (OAuth 2.0)&lt;/b&gt;&lt;br&gt;The only way to sign in. There are no passwords.&lt;br&gt;Redirect URI: /api/auth/callback/google" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#333333;spacingRight=44;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="290" height="100" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b&gt;Store websites&lt;/b&gt; (Rakuten, Yodobashi, Amazon)&lt;br&gt;A deal's url opens in a new tab. The sample deals point at each store's front page." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#333333;spacingRight=44;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="400" height="74" as="geometry"/></mxCell><mxCell id="cf" value="Cloudflare: team account &quot;Sidequest Club&quot;, free plan" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#FFF3E3;strokeColor=#D9730D;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="740" height="794" as="geometry"/></mxCell><mxCell id="worker" value="Worker &quot;bargainu&quot;: https://bargainu.sidequest-club.workers.dev" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="cf"><mxGeometry x="20" y="42" width="700" height="418" as="geometry"/></mxCell><mxCell id="assets" value="&lt;b&gt;Static assets&lt;/b&gt;, deployed together with the API (the Vite build: index.html, JS, CSS, fonts, sample photos)&lt;br&gt;Every path except /api/* is answered here and never runs Worker code. An unknown path gets index.html, so React Router shows the page." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="worker"><mxGeometry x="15" y="40" width="670" height="76" as="geometry"/></mxCell><mxCell id="api" value="Worker API: Hono, worker/index.ts, only /api/*" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="worker"><mxGeometry x="15" y="128" width="440" height="276" as="geometry"/></mxCell><mxCell id="pub" value="&lt;b&gt;Open to everyone&lt;/b&gt;&lt;br&gt;GET /api/health : checks D1 with select 1&lt;br&gt;GET /api/me : the signed-in user, or null&lt;br&gt;GET /api/deals : deals that have not ended, newest first&lt;br&gt;GET, POST /api/auth/* : Better Auth (sign-in, get-session, sign-out)" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="api"><mxGeometry x="10" y="38" width="420" height="106" as="geometry"/></mxCell><mxCell id="priv" value="&lt;b&gt;Behind login&lt;/b&gt; (401 without a session cookie)&lt;br&gt;GET /api/favorites : ids of the saved deals&lt;br&gt;PUT /api/favorites/:dealId : save a deal&lt;br&gt;DELETE /api/favorites/:dealId : remove it&lt;br&gt;Each request looks the session up through Better Auth." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#E3F3E6;strokeColor=#2E7D32;" vertex="1" parent="api"><mxGeometry x="10" y="154" width="420" height="112" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;Worker secrets&lt;/b&gt;&lt;br&gt;Set by hand with wrangler secret put:&lt;br&gt;BETTER_AUTH_URL&lt;br&gt;BETTER_AUTH_SECRET&lt;br&gt;GOOGLE_CLIENT_ID&lt;br&gt;GOOGLE_CLIENT_SECRET" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="worker"><mxGeometry x="470" y="128" width="215" height="126" as="geometry"/></mxCell><mxCell id="limits" value="&lt;b&gt;Logs and limits&lt;/b&gt;&lt;br&gt;Workers Logs are on. The free plan allows 10 ms of CPU per request. The Google callback and sign-out run over it and work on Cloudflare's allowance (decision 5)." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="worker"><mxGeometry x="470" y="266" width="215" height="138" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;D1 database &quot;bargainu&quot;&lt;/b&gt;&lt;br&gt;SQLite, region APAC, bound to the Worker as DB&lt;br&gt;&lt;br&gt;Login tables (Better Auth):&lt;br&gt;user 1, account 1, session 0, verification 0&lt;br&gt;App tables: deals 0, favorites 0&lt;br&gt;&lt;br&gt;Migrations 0000 and 0001 are applied.&lt;br&gt;Row counts read on 2026-10-11." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D9730D;" vertex="1" parent="cf"><mxGeometry x="20" y="550" width="300" height="224" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;R2 bucket for raw collector files&lt;/b&gt;&lt;br&gt;&lt;b&gt;Not set up.&lt;/b&gt; R2 is not enabled on the team account, so no bucket exists.&lt;br&gt;&lt;br&gt;Layout the collector writes:&lt;br&gt;raw/rakuten/&amp;lt;YYYY-MM-DD&amp;gt;/&amp;lt;HHMMSS&amp;gt;Z.ndjson&lt;br&gt;one line per item, exactly as Rakuten returned it.&lt;br&gt;&lt;br&gt;The bucket has to stay private: raw item URLs carry our application ID." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#8A8A8A;fontColor=#555555;dashed=1;dashPattern=6 4;" vertex="1" parent="cf"><mxGeometry x="450" y="550" width="270" height="224" as="geometry"/></mxCell><mxCell id="gh" value="GitHub: sidequest-club/bargainu, public repository" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#EEF0F2;strokeColor=#57606A;" vertex="1" parent="1"><mxGeometry x="1530" y="110" width="610" height="820" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;main&lt;/b&gt;: every merge is deployed. Work arrives through pull requests from feat/ and fix/ branches. No branch protection, no rulesets." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="gh"><mxGeometry x="15" y="42" width="285" height="66" as="geometry"/></mxCell><mxCell id="reviewlabel" value="&lt;b&gt;Actions: Review label&lt;/b&gt; (review-label.yml)&lt;br&gt;Fails a pull request that does not carry exactly one of ai-review or human-review." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="gh"><mxGeometry x="310" y="42" width="285" height="66" as="geometry"/></mxCell><mxCell id="ci" value="Actions: CI (ci.yml), on every pull request and every push to main" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="gh"><mxGeometry x="15" y="116" width="580" height="283" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;check&lt;/b&gt;&lt;br&gt;Format, lint, script tests, API tests (Vitest inside the Workers runtime, empty local D1), build." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="ci"><mxGeometry x="10" y="38" width="275" height="110" as="geometry"/></mxCell><mxCell id="e2e" value="&lt;b&gt;e2e&lt;/b&gt;&lt;br&gt;Playwright in Chromium against the local app and a local D1. Signed in by dev:session, so Google is never called." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="ci"><mxGeometry x="295" y="38" width="275" height="110" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;deploy&lt;/b&gt;&lt;br&gt;Push to main only, after check and e2e pass.&lt;br&gt;1. D1 migrations&lt;br&gt;2. Build, then wrangler deploy" style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="ci"><mxGeometry x="10" y="158" width="275" height="110" as="geometry"/></mxCell><mxCell id="cisecret" value="&lt;b&gt;Repository secret&lt;/b&gt;&lt;br&gt;CLOUDFLARE_API_TOKEN (Workers edit, D1 edit), used by deploy. It is the only secret set, and there are no variables." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#57606A;" vertex="1" parent="ci"><mxGeometry x="295" y="158" width="275" height="110" as="geometry"/></mxCell><mxCell id="collect" value="Actions: Collect (collect.yml), started by hand only, never run" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#F7F7F7;strokeColor=#8A8A8A;fontColor=#555555;dashed=1;dashPattern=6 4;" vertex="1" parent="gh"><mxGeometry x="15" y="431" width="580" height="372" as="geometry"/></mxCell><mxCell id="upload" value="&lt;b&gt;2. Upload raw files to R2&lt;/b&gt;&lt;br&gt;aws s3 cp to R2's S3-compatible endpoint. Runs even when step 1 failed, so a partial file is kept." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#8A8A8A;fontColor=#555555;dashed=1;dashPattern=6 4;" vertex="1" parent="collect"><mxGeometry x="10" y="38" width="270" height="118" as="geometry"/></mxCell><mxCell id="rakutenpy" value="&lt;b&gt;1. collector/rakuten.py&lt;/b&gt;&lt;br&gt;Python, standard library only. Searches by keyword, 30 items a page, one request every 1.5 s. Saves the response unchanged as NDJSON." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#8A8A8A;fontColor=#555555;dashed=1;dashPattern=6 4;" vertex="1" parent="collect"><mxGeometry x="300" y="38" width="270" height="118" as="geometry"/></mxCell><mxCell id="nosecrets" value="&lt;b&gt;Not set in the repository:&lt;/b&gt; the secrets RAKUTEN_APP_ID, RAKUTEN_ACCESS_KEY, RAKUTEN_AFFILIATE_ID, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY, and the variable R2_BUCKET. The workflow cannot succeed until they are." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FDECEA;strokeColor=#C62828;fontColor=#8E1B1B;dashed=1;dashPattern=6 4;" vertex="1" parent="collect"><mxGeometry x="10" y="168" width="430" height="90" as="geometry"/></mxCell><mxCell id="normalize" value="&lt;b&gt;collector/normalize.py&lt;/b&gt;: a draft cleaning step, run by hand on a laptop and not part of the workflow. It removes the application ID from URLs and converts times. Its fields do not match the deals table (SID-17)." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#F7F7F7;strokeColor=#8A8A8A;fontColor=#555555;dashed=1;dashPattern=6 4;" vertex="1" parent="collect"><mxGeometry x="10" y="270" width="430" height="90" as="geometry"/></mxCell><mxCell id="laptop" value="A developer's laptop (local development, separate from production)" style="swimlane;startSize=30;fontFamily=Helvetica;fontSize=12;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;arcSize=6;swimlaneFillColor=default;fillColor=#F3EEF9;strokeColor=#6A4BA3;" vertex="1" parent="1"><mxGeometry x="640" y="960" width="740" height="176" as="geometry"/></mxCell><mxCell id="localdev" value="&lt;b&gt;npm run dev&lt;/b&gt;: Vite plus the Worker in the Workers runtime, with a local D1 and the values in .dev.vars.&lt;br&gt;db:seed:local loads 60 invented sample deals.&lt;br&gt;dev:session writes a test user and cookie, local database only." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#6A4BA3;" vertex="1" parent="laptop"><mxGeometry x="15" y="40" width="350" height="122" as="geometry"/></mxCell><mxCell id="byhand" value="&lt;b&gt;By hand with wrangler&lt;/b&gt;: secret put, tail, and db:seed:remote (not used: the deployed deals table is empty).&lt;br&gt;The collector also runs locally with collector/.env. Local runs write to collector/out and do not upload." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#6A4BA3;" vertex="1" parent="laptop"><mxGeometry x="375" y="40" width="350" height="122" as="geometry"/></mxCell><mxCell id="rakuten" value="&lt;b&gt;Rakuten Ichiba Item Search API&lt;/b&gt;&lt;br&gt;Version 20260701, needs an application ID and access key. Returns itemPrice only: there is no original price." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#333333;spacingRight=44;" vertex="1" parent="1"><mxGeometry x="1830" y="960" width="310" height="100" as="geometry"/></mxCell><mxCell id="gaps" value="&lt;b style=&quot;font-size:14px&quot;&gt;What is missing today&lt;/b&gt;&lt;br&gt;1. Nothing loads collected data into D1: there is no ingest endpoint and no loader Worker (SID-23, SID-28). The deployed deals table is empty, so the live site shows &quot;The pile is empty&quot;.&lt;br&gt;2. R2 is not enabled on the team account, and the Collect workflow's secrets and variable are not set. Collect has never run on GitHub.&lt;br&gt;3. Collection has no schedule and covers Rakuten only. Nothing exists for Yodobashi or Amazon.&lt;br&gt;4. The deal data model is not agreed (SID-17): Rakuten gives no original price, and the fields normalize.py writes do not match the deals table.&lt;br&gt;5. main has no branch protection, so nothing on GitHub stops a direct push from being deployed.&lt;br&gt;6. Sign-in runs over the free plan's 10 ms CPU limit and works on Cloudflare's allowance (decision 5).&lt;br&gt;7. The app is served from workers.dev only: wrangler.jsonc has no custom domain or route.&lt;br&gt;8. Rakuten's terms (decision 6) allow a price to be kept for 24 hours and require a credit, an update time and a disclaimer by each price. Nothing refreshes or deletes stored data yet, and the screens show none of these." style="rounded=1;arcSize=6;absoluteArcSize=1;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#FDECEA;strokeColor=#C62828;fontColor=#8E1B1B;dashed=1;dashPattern=6 4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="2100" height="166" as="geometry"/></mxCell><mxCell id="i_browser" value="" style="html=1;pointerEvents=0;connectable=0;sketch=0;shadow=0;dashed=0;strokeColor=none;fillColor=#3B6FB6;aspect=fixed;shape=mxgraph.vvd.web_browser;" vertex="1" parent="browser"><mxGeometry x="10" y="6" width="26" height="19" as="geometry"/></mxCell><mxCell id="i_cf" value="" style="html=1;pointerEvents=0;connectable=0;shape=image;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/font-awesome/1/Cloudflare_brand.svg;" vertex="1" parent="cf"><mxGeometry x="10" y="4" width="28" height="22" as="geometry"/></mxCell><mxCell id="i_gh" value="" style="html=1;pointerEvents=0;connectable=0;dashed=0;outlineConnect=0;shape=mxgraph.weblogos.github;" vertex="1" parent="gh"><mxGeometry x="10" y="4" width="22" height="22" as="geometry"/></mxCell><mxCell id="i_laptop" value="" style="html=1;pointerEvents=0;connectable=0;sketch=0;aspect=fixed;shadow=0;dashed=0;strokeColor=none;fillColor=#6A4BA3;shape=mxgraph.azure.laptop;" vertex="1" parent="laptop"><mxGeometry x="10" y="6" width="30" height="18" as="geometry"/></mxCell><mxCell id="i_google" value="" style="html=1;pointerEvents=0;connectable=0;dashed=0;outlineConnect=0;shape=mxgraph.weblogos.google;" vertex="1" parent="1"><mxGeometry x="404" y="688" width="26" height="28" as="geometry"/></mxCell><mxCell id="i_stores" value="" style="html=1;pointerEvents=0;connectable=0;shadow=0;dashed=0;strokeWidth=2;strokeColor=#333333;shape=mxgraph.ios7.icons.shopping_cart;" vertex="1" parent="1"><mxGeometry x="404" y="848" width="26" height="22" as="geometry"/></mxCell><mxCell id="i_rakuten" value="" style="html=1;pointerEvents=0;connectable=0;shadow=0;dashed=0;strokeWidth=2;strokeColor=#333333;shape=mxgraph.ios7.icons.shopping_cart;" vertex="1" parent="1"><mxGeometry x="2104" y="968" width="26" height="22" as="geometry"/></mxCell><mxCell id="e1" value="page load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.685;exitDx=0;exitDy=0;entryX=0;entryY=0.303;entryDx=0;entryDy=0;" edge="1" parent="1" source="spa" target="assets"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="deals, session, sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.494;exitDx=0;exitDy=0;entryX=0;entryY=0.208;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="pub"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="favorites + cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.313;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" parent="1" source="behind" target="priv"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="sign-in: to Google and&lt;br&gt;back to the callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;exitX=0.65;exitY