<mxfile host="Electron"><diagram id="how-we-work" name="How we work"><mxGraphModel adaptiveColors="auto" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-meet" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3220" height="120" as="geometry"/></mxCell><mxCell id="head-meet" value="Meetings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="120" height="120" as="geometry"/></mxCell><mxCell id="lane-linear" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="3220" height="180" as="geometry"/></mxCell><mxCell id="head-linear" value="Linear" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="120" height="180" as="geometry"/></mxCell><mxCell id="lane-figma" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="3220" height="200" as="geometry"/></mxCell><mxCell id="head-figma" value="Figma" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="120" height="200" as="geometry"/></mxCell><mxCell id="lane-github" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="3220" height="220" as="geometry"/></mxCell><mxCell id="head-github" value="GitHub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="120" height="220" as="geometry"/></mxCell><mxCell id="lane-host" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="720" width="3220" height="110" as="geometry"/></mxCell><mxCell id="head-host" value="Hosting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="720" width="120" height="110" as="geometry"/></mxCell><mxCell id="lane-slack" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="830" width="3220" height="120" as="geometry"/></mxCell><mxCell id="head-slack" value="Slack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="830" width="120" height="120" as="geometry"/></mxCell><mxCell id="monday" value="&lt;b&gt;Lead&lt;/b&gt;&lt;br&gt;Monday meeting: picks the week's work and assigns each task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="25" width="175" height="70" as="geometry"/></mxCell><mxCell id="midweek" value="&lt;b&gt;Anyone&lt;/b&gt;&lt;br&gt;Work that comes up mid-week gets an issue before it starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="215" width="175" height="70" as="geometry"/></mxCell><mxCell id="issue" value="&lt;b&gt;Lead or owner&lt;/b&gt;&lt;br&gt;Issue: owner, reviewer, &quot;done when&quot;, review label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="355" y="175" width="175" height="80" as="geometry"/></mxCell><mxCell id="ui" value="Does it change a screen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="355" width="165" height="95" as="geometry"/></mxCell><mxCell id="mock" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Mock first, not limited to the data we know" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="320" width="175" height="60" as="geometry"/></mxCell><mxCell id="research" value="&lt;b&gt;Teammate, in parallel&lt;/b&gt;&lt;br&gt;Find out what data the source gives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="415" width="175" height="60" as="geometry"/></mxCell><mxCell id="mapping" value="&lt;b&gt;Claude, then the team&lt;/b&gt;&lt;br&gt;Data-element mapping: is each element feasible?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="365" width="175" height="70" as="geometry"/></mxCell><mxCell id="remock" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Mock again to fit the data, desktop and phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1175" y="365" width="175" height="70" as="geometry"/></mxCell><mxCell id="agree" value="&lt;b&gt;Team&lt;/b&gt;&lt;br&gt;Comment on each element and agree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="365" width="175" height="70" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Owner + agent&lt;/b&gt;&lt;br&gt;Build on a branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1585" y="525" width="175" height="70" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Open the pull request, 5 lines for a person on top" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1790" y="525" width="175" height="70" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;CI + AI reviewer&lt;/b&gt;&lt;br&gt;Checks and AI review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1995" y="525" width="175" height="70" as="geometry"/></mxCell><mxCell id="findings" value="Review findings?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2210" y="515" width="155" height="90" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Fix on the same branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2200" y="630" width="175" height="70" as="geometry"/></mxCell><mxCell id="newissue" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Outside the pull request's scope: new issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2200" y="175" width="175" height="80" as="geometry"/></mxCell><mxCell id="label" value="Which label?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2415" y="515" width="155" height="90" as="geometry"/></mxCell><mxCell id="human" value="&lt;b&gt;Reviewer&lt;/b&gt;&lt;br&gt;Tries it and answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2405" y="630" width="175" height="70" as="geometry"/></mxCell><mxCell id="merge" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Merges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2610" y="525" width="175" height="70" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;CI&lt;/b&gt;&lt;br&gt;Deploys. It is live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2610" y="740" width="175" height="70" as="geometry"/></mxCell><mxCell id="aipost" value="&lt;b&gt;AI reviewer&lt;/b&gt;&lt;br&gt;Posts the outcome to the updates channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1995" y="855" width="175" height="70" as="geometry"/></mxCell><mxCell id="done" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Issue Done, branch and pull request linked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2815" y="175" width="175" height="80" as="geometry"/></mxCell><mxCell id="post" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Short message in the project channel, long version in the updates channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2815" y="855" width="175" height="70" as="geometry"/></mxCell><mxCell id="friday" value="&lt;b&gt;Lead&lt;/b&gt;&lt;br&gt;Friday meeting: demo what works, look at what did not get done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="3020" y="25" width="175" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exit