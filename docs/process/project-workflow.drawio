<mxfile host="Electron"><diagram id="project-workflow" name="A project, end to end"><mxGraphModel adaptiveColors="auto" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-meet" value="" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="2160" height="160" as="geometry"/></mxCell><mxCell id="head-meet" value="Meetings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="120" height="160" as="geometry"/></mxCell><mxCell id="lane-linear" value="" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="2160" height="140" as="geometry"/></mxCell><mxCell id="head-linear" value="Linear" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="120" height="140" as="geometry"/></mxCell><mxCell id="lane-figma" value="" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="2160" height="150" as="geometry"/></mxCell><mxCell id="head-figma" value="Figma" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="120" height="150" as="geometry"/></mxCell><mxCell id="lane-github" value="" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="2160" height="230" as="geometry"/></mxCell><mxCell id="head-github" value="GitHub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="120" height="230" as="geometry"/></mxCell><mxCell id="lane-host" value="" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="0" y="720" width="2160" height="120" as="geometry"/></mxCell><mxCell id="head-host" value="Hosting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#d0d0d0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="720" width="120" height="120" as="geometry"/></mxCell><mxCell id="stage-0" value="1. Idea" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#b3b3b3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="0" width="260" height="40" as="geometry"/></mxCell><mxCell id="stage-1" value="2. Plan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#b3b3b3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="0" width="840" height="40" as="geometry"/></mxCell><mxCell id="div-1" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="0" as="sourcePoint"/><mxPoint x="380" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="stage-2" value="3. Build, a week at a time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#b3b3b3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1220" y="0" width="440" height="40" as="geometry"/></mxCell><mxCell id="div-2" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="0" as="sourcePoint"/><mxPoint x="1220" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="stage-3" value="4. Launch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#b3b3b3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1660" y="0" width="240" height="40" as="geometry"/></mxCell><mxCell id="div-3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="0" as="sourcePoint"/><mxPoint x="1660" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="stage-4" value="5. Look back" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#b3b3b3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1900" y="0" width="260" height="40" as="geometry"/></mxCell><mxCell id="div-4" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#b3b3b3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="0" as="sourcePoint"/><mxPoint x="1900" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="idea" value="&lt;b&gt;Team&lt;/b&gt;&lt;br&gt;The idea: what, why, what not, and the end date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="88" width="180" height="64" as="geometry"/></mxCell><mxCell id="project" value="&lt;b&gt;Lead&lt;/b&gt;&lt;br&gt;Linear project, with a milestone for each step and week" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="238" width="180" height="64" as="geometry"/></mxCell><mxCell id="features" value="&lt;b&gt;Team&lt;/b&gt;&lt;br&gt;Define what each feature means, and what is left out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="545" width="180" height="64" as="geometry"/></mxCell><mxCell id="mock" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Mock first, not limited to the data we know" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="383" width="180" height="64" as="geometry"/></mxCell><mxCell id="research" value="&lt;b&gt;Teammate, in parallel&lt;/b&gt;&lt;br&gt;Research the data sources and their terms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="545" width="180" height="64" as="geometry"/></mxCell><mxCell id="mapping" value="&lt;b&gt;Claude, then the team&lt;/b&gt;&lt;br&gt;Data-element mapping: is each element feasible?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="383" width="180" height="64" as="geometry"/></mxCell><mxCell id="remock" value="&lt;b&gt;Owner, then the team&lt;/b&gt;&lt;br&gt;Mock again to fit the data, desktop and phone. Agree in Figma" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1015" y="383" width="180" height="64" as="geometry"/></mxCell><mxCell id="arch" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;How the parts connect, the stack and the data model, as decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1015" y="520" width="180" height="64" as="geometry"/></mxCell><mxCell id="setup" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;Repo, CI and deploy on merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1015" y="625" width="180" height="64" as="geometry"/></mxCell><mxCell id="issues" value="&lt;b&gt;Lead&lt;/b&gt;&lt;br&gt;Break the plan into issues under the milestones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1015" y="238" width="180" height="64" as="geometry"/></mxCell><mxCell id="planok" value="All three agree the plan?" style="rhombus;whiteSpace=wrap;html=1;fillColor